{
  "$defs": {
    "Assertion": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "visible",
                  "text",
                  "value",
                  "checked"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "type": "object"
              }
            },
            "required": [
              "target"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "url",
                  "value"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "expected": {
                "type": "string"
              }
            },
            "required": [
              "expected"
            ]
          }
        }
      ],
      "properties": {
        "type": {
          "enum": [
            "visible",
            "text",
            "url",
            "value",
            "checked"
          ],
          "title": "Type",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        }
      },
      "required": [
        "type"
      ],
      "title": "Assertion",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "start_ms": {
          "minimum": 0,
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "minimum": 0,
          "title": "End Ms",
          "type": "integer"
        },
        "frame_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Frame Ids",
          "type": "array"
        }
      },
      "required": [
        "start_ms",
        "end_ms",
        "frame_ids"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Step": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "action": {
          "enum": [
            "click",
            "fill",
            "select",
            "check",
            "press",
            "navigate"
          ],
          "title": "Action",
          "type": "string"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Evidence"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "status": {
          "default": "needs_review",
          "enum": [
            "needs_review",
            "approved"
          ],
          "title": "Status",
          "type": "string"
        },
        "sensitive": {
          "default": false,
          "title": "Sensitive",
          "type": "boolean"
        },
        "verification": {
          "$ref": "#/$defs/Assertion"
        }
      },
      "required": [
        "id",
        "action",
        "description",
        "source",
        "confidence",
        "verification"
      ],
      "title": "Step",
      "type": "object"
    },
    "Target": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "strategy": {
          "enum": [
            "role",
            "label",
            "text",
            "placeholder"
          ],
          "title": "Strategy",
          "type": "string"
        },
        "value": {
          "minLength": 1,
          "title": "Value",
          "type": "string"
        },
        "role": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Role"
        }
      },
      "required": [
        "description",
        "strategy",
        "value"
      ],
      "title": "Target",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "title": "Title",
      "type": "string"
    },
    "parameters": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Parameters",
      "type": "object"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "steps": {
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 50,
      "minItems": 1,
      "title": "Steps",
      "type": "array"
    },
    "postconditions": {
      "items": {
        "$ref": "#/$defs/Assertion"
      },
      "minItems": 1,
      "title": "Postconditions",
      "type": "array"
    }
  },
  "required": [
    "title",
    "parameters",
    "preconditions",
    "uncertainties",
    "steps",
    "postconditions"
  ],
  "title": "Draft",
  "type": "object"
}
