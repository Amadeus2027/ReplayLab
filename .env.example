# These are examples only. Export variables in your shell; .env is NOT auto-loaded.
REPLAYLAB_BASE_URL=https://api.deepseek.com
REPLAYLAB_API_KEY=
REPLAYLAB_MODEL=deepseek-flash
# Optional: absolute path to an existing Chromium executable.
# REPLAYLAB_BROWSER_EXECUTABLE=/usr/bin/chromium
# Optional: persistent local task directory (default: .replaylab in current directory).
# REPLAYLAB_DATA_DIR=/absolute/path/to/replaylab-data
